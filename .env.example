# TaxSathi AI — Environment Variables
# Copy this to backend/.env and fill in your values

# ─── App ─────────────────────────────────
APP_NAME=TaxSathi AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ─── Database ────────────────────────────
# SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./taxsathi.db
# DATABASE_URL=postgresql+asyncpg://taxsathi:taxsathi_secret@postgres:5432/taxsathi_db

# ─── Auth ────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-string-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin ───────────────────────────────
ADMIN_EMAIL=admin@taxsathi.ai
ADMIN_PASSWORD=admin123456

# ─── LLM (Gemini — primary) ─────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# ─── LLM (OpenAI — fallback) ────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ─── Embeddings ──────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Reranker ────────────────────────────
COHERE_API_KEY=your-cohere-api-key-here

# ─── Vector Store ────────────────────────
VECTOR_STORE_TYPE=chromadb
CHROMADB_PERSIST_DIR=./chroma_data
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX=taxsathi

# ─── Rate Limiting ───────────────────────
RATE_LIMIT_PER_MINUTE=30

# ─── Upload ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── CORS ────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ─── Maintenance ─────────────────────────
MAINTENANCE_MODE=false
