# TaxSathi AI — Environment Variables
# Copy this to backend/.env and fill in your values.
# NEVER commit the actual .env file.

# ─── App ─────────────────────────────────
APP_NAME=TaxSathi AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ─── Security ────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin ───────────────────────────────
# REQUIRED — set a strong password; the app hashes it at startup.
ADMIN_EMAIL=admin@taxsathi.ai
ADMIN_PASSWORD=

# ─── Database ────────────────────────────
# SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./taxsathi.db
# DATABASE_URL=postgresql+asyncpg://taxsathi:password@postgres:5432/taxsathi_db

# ─── Redis (optional in dev) ─────────────
REDIS_URL=redis://localhost:6379/0

# ─── LLM (Gemini — primary) ─────────────
# REQUIRED — obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── LLM (OpenAI — fallback) ────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Embeddings ──────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Reranker ────────────────────────────
COHERE_API_KEY=

# ─── Vector Store ────────────────────────
VECTOR_STORE_TYPE=chromadb
CHROMADB_PERSIST_DIR=./chroma_data
# PINECONE_API_KEY=
# PINECONE_INDEX=taxsathi

# ─── Rate Limiting ───────────────────────
RATE_LIMIT_PER_MINUTE=30

# ─── Upload ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── CORS ────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Maintenance ─────────────────────────
MAINTENANCE_MODE=false
